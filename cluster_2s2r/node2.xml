<clickhouse>
    <logger>
        <level>information</level>
        <log>/root/work/ClickHouse/tmp/cluster_2s2r/logs/node2.log</log>
        <errorlog>/root/work/ClickHouse/tmp/cluster_2s2r/logs/node2.err.log</errorlog>
        <console>1</console>
    </logger>
    <path>/root/work/ClickHouse/tmp/cluster_2s2r/node2/data/</path>
    <tmp_path>/root/work/ClickHouse/tmp/cluster_2s2r/node2/tmp/</tmp_path>
    <user_files_path>/root/work/ClickHouse/tmp/cluster_2s2r/node2/user_files/</user_files_path>
    <format_schema_path>/root/work/ClickHouse/tmp/cluster_2s2r/node2/format_schemas/</format_schema_path>
    <users_config>/root/ClickHouse/build_release/programs/users.xml</users_config>
    <listen_host>127.0.0.1</listen_host>
    <tcp_port>19101</tcp_port>
    <http_port>18224</http_port>
    <interserver_http_host>127.0.0.1</interserver_http_host>
    <interserver_http_port>19110</interserver_http_port>
    <zookeeper>
        <node><host>192.168.153.128</host><port>9281</port></node>
        <node><host>192.168.153.128</host><port>9282</port></node>
        <node><host>192.168.153.128</host><port>9283</port></node>
    </zookeeper>
    <auxiliary_zookeepers>
        <cluster_keeper>
            <node><host>192.168.153.128</host><port>9281</port></node>
            <node><host>192.168.153.128</host><port>9282</port></node>
            <node><host>192.168.153.128</host><port>9283</port></node>
        </cluster_keeper>
    </auxiliary_zookeepers>
    <cluster_metadata>
        <keeper>cluster_keeper</keeper>
        <path>/clickhouse/clusters_metadata</path>
        <encrypted>false</encrypted>
        <key_hex>bebec0cabebec0cabebec0cabebec0ca</key_hex>
        <replica_group>group_b</replica_group>
        <imports>
            <replica_group>group_a</replica_group>
        </imports>
    </cluster_metadata>
    <named_collections_storage>
        <type>keeper</type>
        <path>/clickhouse/named_collections</path>
        <update_timeout_ms>5000</update_timeout_ms>
    </named_collections_storage>
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    <!-- Required for create_10000_endpoints.sh timing via system.query_log. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
        <flush_on_crash>false</flush_on_crash>
    </query_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>
    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <collect_interval_milliseconds>1000</collect_interval_milliseconds>
    </metric_log>
    <macros>
        <shard>1</shard>
        <replica>s1r2</replica>
    </macros>
    <remote_servers>
        <demo_2s2r>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>127.0.0.1</host><port>19100</port></replica>
                <replica><host>127.0.0.1</host><port>19101</port></replica>
            </shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>127.0.0.1</host><port>19102</port></replica>
                <replica><host>127.0.0.1</host><port>19103</port></replica>
            </shard>
        </demo_2s2r>
    </remote_servers>
</clickhouse>
